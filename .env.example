APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anderson_farm_be
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Upload disk: "r2" in production, "public" for local-only without R2 credentials
FILESYSTEM_UPLOAD_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 object storage (bucket: anderson-farm)
# Enable public access (or custom domain) on the bucket so app can open file_url.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=anderson-farm
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_URL=https://<public-r2-or-custom-domain>
R2_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Excel export (ARGB 8 digit atau RGB 6 digit)
HEADER_TABLE_COLOR=FFC6EFCE

# Mobile app version gatekeeper (GET /api/v1/system/check-version)
# Keep in sync with anderson-farm-fe app.json "version" while still pre-1.0.
LATEST_APP_VERSION=0.1.0
MIN_APP_VERSION=0.1.0
APP_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.andersonfarm.app
APP_UPDATE_URL_IOS=https://apps.apple.com/app/anderson-farm/id000000000
