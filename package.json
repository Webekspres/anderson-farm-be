{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve:mobile": "bash scripts/serve-mobile.sh",
        "serve:mobile:queue": "bash scripts/serve-mobile.sh --with-queue",
        "sync-api": "dotenv -- bash -c 'redocly bundle docs/apicontract/openapi/openapi.yaml -o docs/apicontract/openapi/dist.yaml && postman api update-definition $POSTMAN_API_ID --definition docs/apicontract/openapi/dist.yaml'"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": ">=1.11.0 <=1.14.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
